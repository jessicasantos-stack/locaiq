# ── Supabase ─────────────────────────────────────────────────
# Get from: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Claude / Anthropic ────────────────────────────────────────
# NEVER expose on frontend — stays server-side only
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Google OAuth (for GBP API) ────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
# IMPORTANT: In Google Cloud Console, set the redirect URI to:
#   https://<your-supabase-project>.supabase.co/auth/v1/callback
# Then in Supabase Dashboard → Authentication → Providers → Google:
#   paste Client ID and Client Secret
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Stripe ───────────────────────────────────────────────────
# Get from: dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs (create in Stripe → Products)
STRIPE_STARTER_PRICE_ID=price_...   # $99/mo
STRIPE_AGENCY_PRICE_ID=price_...    # $299/mo
STRIPE_SCALE_PRICE_ID=price_...     # $499/mo

# ── Resend (email reports) ────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=re_...
FROM_EMAIL=reports@zenithseo.com

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_URL=http://localhost:3000
CRON_SECRET=generate-random-string-here
