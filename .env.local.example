# ── Claude / Anthropic ────────────────────────────────────────
# NUNCA expor no frontend — fica APENAS aqui no servidor
# Pegar em: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Google OAuth (GBP API) ────────────────────────────────────
# Pegar em: console.cloud.google.com → APIs → Credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=https://locaiq.com/api/auth/callback

# ── Stripe ───────────────────────────────────────────────────
# Pegar em: dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs (criar em Stripe → Products)
